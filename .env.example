# ── Neo4j ──────────────────────────────────────────────────────────
NEO4J_USER=neo4j
# REQUIRED: Neo4j password (do not use 'changeme' in production)
NEO4J_PASSWORD=

# ── Query API protection ────────────────────────────────────────────
# REQUIRED: API key for query/ingestion/mcp APIs
# With the default value, requests are rejected (fail-closed)
QUERY_API_KEY=

# ── LLM Provider ───────────────────────────────────────────────────
# Options: openai | anthropic | google | openrouter | openai_compatible | ollama
LLM_PROVIDER=openai

# Set the key for whichever provider you use (others can be blank)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...

# OpenRouter (https://openrouter.ai)
# Models: openai/gpt-4o, anthropic/claude-3.5-sonnet, google/gemini-2.0-flash, etc.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openai/gpt-4o

# OpenAI-Compatible (any OpenAI-compatible API gateway)
OPENAI_COMPATIBLE_API_KEY=sk-...
OPENAI_COMPATIBLE_BASE_URL=http://your-openai-compatible-gateway:8000
OPENAI_COMPATIBLE_MODEL=your-model-name

# For local Ollama (runs outside Docker on host)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# ── Embedding Provider ────────────────────────────────────────────
# Options: openai | google | huggingface | openai_compatible
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Popular embedding models:
# OpenAI:
#   - text-embedding-3-small (1536 dim, fast, cheap)
#   - text-embedding-3-large (3072 dim, slower, more expensive)
#
# Google:
#   - models/text-embedding-004
#
# HuggingFace (local, free):
#   - all-MiniLM-L6-v2
#   - all-mpnet-base-v2
#   - intfloat/e5-base

# ── Ingestion tuning ────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
EXTRACT_ENTITIES=true

# ── Security ────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173
# Skip API key checks entirely (local dev only, never in production)
INSECURE_DEV_MODE=false
