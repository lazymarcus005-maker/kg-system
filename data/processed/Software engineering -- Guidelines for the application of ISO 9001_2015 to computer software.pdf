               <rdf:li>documentation</rdf:li>
               <rdf:li>management review</rdf:li>
               <rdf:li>project management</rdf:li>
               <rdf:li>quality assurance</rdf:li>
               <rdf:li>quality control</rdf:li>
               <rdf:li>quality management</rdf:li>
               <rdf:li>quality plan</rdf:li>
               <rdf:li>release</rdf:li>
               <rdf:li>review</rdf:li>
               <rdf:li>software quality</rdf:li>
               <rdf:li>testing</rdf:li>
               <rdf:li>validation</rdf:li>
               <rdf:li>verification</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">ï»¿ISO/IEC/IEEE 90003:2018ï»¿, Software engineering â€” Guidelines for the application of ISO 9001:2015 to computer software</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>IEEE Computer Society</rdf:li>
            </rdf:Seq>
